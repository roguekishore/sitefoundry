    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "react-docgen-typescript": "^2.4.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
