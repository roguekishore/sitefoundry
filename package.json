{
  "name": "sitefoundry",
  "private": true,
  "type": "module",
  "scripts": {
    "build:registry": "tsx tools/build-registry.ts",
    "build:registry:vault": "tsx tools/build-registry.ts --vault",
    "build:thumbs": "tsx tools/build-thumbs.ts",
    "build:thumbs:vault": "tsx tools/build-thumbs.ts --vault",
    "check": "tsx tools/check.ts",
    "check:vault": "tsx tools/check.ts --vault",
    "gallery": "pnpm --filter gallery dev",
    "gallery:vault": "pnpm --filter gallery dev:vault",
    "build:cli": "pnpm --filter @foundry/cli build",
    "build:mcp": "pnpm --filter @foundry/mcp build",
    "build:server": "pnpm --filter @foundry/server build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "serve": "node packages/server/dist/server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/antonio": "^5.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/arimo": "^5.3.0",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/encode-sans-expanded": "^5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inria-serif": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/la-belle-aurore": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@foundry/core": "workspace:*",
