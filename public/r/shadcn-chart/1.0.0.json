    {
      "name": "content",
      "type": "ContentType",
      "required": false,
      "description": "Renders the content of the legend.\n\nThis should return HTML elements, not SVG elements.\n\n- If not set, the {@link DefaultLegendContent } component is used.\n- If set to a React element, this element will be cloned and extra props will be passed in.\n- If set to a function, the function will be called and should return HTML elements.\n@example <Legend content={CustomizedLegend} />\n@example <Legend content={renderLegend} />"
    },
    {
      "name": "layout",
      "type": "enum",
      "required": false,
      "description": "The layout of legend items inside the legend container.\n\nWhen `auto` then the layout is decided based on the `position` prop:\n- in `left`|`right` positions, the layout is vertical\n- otherwise horizontal\n- if position is undefined, also horizontal\n\n`auto` value is new since 3.10\n@defaultValue auto"
    },
    {
      "name": "wrapperStyle",
      "type": "CSSProperties",
      "required": false,
      "description": "CSS styles to be applied to the wrapper `div` element."
    },
    {
      "name": "width",
      "type": "string | number",
      "required": false,
      "description": "Width of the legend.\nAccept CSS style string values like `100%` or `fit-content`, or number values like `400`."
    },
    {
      "name": "height",
      "type": "string | number",
      "required": false,
      "description": "Height of the legend.\nAccept CSS style string values like `100%` or `fit-content`, or number values like `400`."
    },
    {
      "name": "payloadUniqBy",
      "type": "UniqueOption<LegendPayload>",
      "required": false
    },
    {
      "name": "onBBoxUpdate",
      "type": "((box: ElementOffset | null) => void)",
      "required": false
    },
    {
      "name": "portal",
      "type": "HTMLElement | null",
      "required": false,
      "description": "If portal is defined, then Legend will use this element as a target\nfor rendering using React Portal.\n\nIf this is undefined then Legend renders inside the recharts-wrapper element.\n@see {@link https://react.dev/reference/react-dom/createPortal}"
    },
    {
      "name": "itemSorter",
      "type": "LegendItemSorter | null",
      "required": false,
      "description": "Sorts Legend items. Defaults to `value` which means it will sort alphabetically\nby the label.\n\nIf `null` is provided then the payload is not sorted. Be aware that without sort,\nthe order of items may change between renders!\n@defaultValue value"
    },
    {
      "name": "verticalAlign",
      "type": "enum",
      "required": false,
      "description": "@deprecated use `position` instead which has more options, is more flexible and has more intuitive default styles.\n@description The alignment of the whole Legend container:\n\n- `bottom`: shows the Legend below chart, and chart height reduces automatically to make space for it.\n- `top`: shows the Legend above chart, and chart height reduces automatically.\n- `middle`:  shows the Legend in the middle of chart, covering other content, and chart height remains unchanged.\nThe exact behavior changes depending on `align` prop.\n@defaultValue bottom\n@see {@link https://recharts.github.io/examples/LegendPosition/ Legend position playground}"
    },
    {
      "name": "position",
      "type": "CartesianPosition",
      "required": false,
      "description": "The position of the legend relative to the chart.\nIf this is defined, it overrides `align` and `verticalAlign`.\n@since 3.10"
    },
    {
      "name": "offset",
      "type": "number",
      "required": false,
      "description": "The offset to the specified `position`. Direction of the offset depends on the position.\n@since 3.10"
    }
  ],
